// every cloud/haze particle adds its weight to the voxel it falls in
layout(local_size_x = 256) in;
layout(r32ui, binding = 0) uniform uimage3D acc;
uniform int u_n;
uniform ivec3 u_res;
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_n) return;
    vec4 a, b;
    vec3 p = particlePos(i, a, b);
    if (b.z > 1.5) return;                          // rain is drawn, not part of the cloud volume
    ivec3 v = ivec3(floor(boxUVW(p) * vec3(u_res)));
    if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, u_res))) return;
    imageAtomicAdd(acc, v, uint(a.w * 16.0 + 0.5));
}
