// particle counts → smoothed, saturated density (+ flat base, carved tunnel)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
layout(r32ui, binding = 0) readonly uniform uimage3D acc;
layout(r16f, binding = 1) writeonly uniform image3D dens;
uniform ivec3 u_res;
uniform float u_ref, u_base;
float C(ivec3 v) { return float(imageLoad(acc, clamp(v, ivec3(0), u_res - 1)).r); }
void main() {
    ivec3 v = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(v, u_res))) return;
    float c = 2.0 * C(v) + C(v + ivec3(1, 0, 0)) + C(v - ivec3(1, 0, 0)) + C(v + ivec3(0, 1, 0))
            + C(v - ivec3(0, 1, 0)) + C(v + ivec3(0, 0, 1)) + C(v - ivec3(0, 0, 1));
    c /= 8.0 * 16.0 * u_ref;
    vec3 p = u_boxMin + (vec3(v) + 0.5) / vec3(u_res) * (u_boxMax - u_boxMin);
    float d = 1.0 - exp(-1.3 * c);
    d *= carve(p) * smoothstep(u_base - 0.3, u_base + 0.12, p.y);
    imageStore(dens, v, vec4(d));
}
