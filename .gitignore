# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Manim output
media/

# Rendered video output
videos/*/out/
lab/**/out/
kaggle/
sfx/
*.mp4
*.png
*.mov
*.webm
*.gif
frames/

# Production inputs (large audio; keep SRT/scripts tracked)
videos/*/assets/*.mp3
videos/*/assets/*.wav

# LaTeX / editor / OS junk
*.aux
*.log
*.dvi
.DS_Store
.vscode/
.idea/

# Secrets and third-party installs
.env
.env.*
!.env.example
**/node_modules/
Eleven Labs/

# aion caches; golden test frames and doc images are tracked
.aion-cache/
!tests/golden/**/*.png
!docs/img/**/*.png
